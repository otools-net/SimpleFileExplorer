<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the C# client library against the real server in process. The server's test helpers
    (tests/Sfe.Tests/Infrastructure: TestLibrary, ApiClients, TokenClients) come with the reference to Sfe.Tests:
    one copy for both projects. Its tests are not run from here (MSTest only runs this assembly's).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Otools.Net.Sfe.Client.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="MSTest" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Otools.Net.Sfe.Tests.Infrastructure.ApiPaths" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sfe.Client\Sfe.Client.csproj" />
    <ProjectReference Include="..\Sfe.Tests\Sfe.Tests.csproj" />
  </ItemGroup>
</Project>
