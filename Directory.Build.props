<Project>

  <!--
    The version of SFE, for every project: bump it here for a release (semantic versioning: major.minor.patch).
    The SDK appends the commit to the informational version (1.2.0+<sha>), which the app shows next to it
    (AppVersion.cs). Portable packages are named after it (build/build.ps1, build/build.sh), which read it with
    `dotnet msbuild -getProperty:Version`; their version argument overrides it (e.g. 1.3.0-beta.1).
  -->
  <PropertyGroup>
    <Version>1.38.0</Version>
  </PropertyGroup>

</Project>
