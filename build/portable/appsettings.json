{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",

  "ConnectionStrings": {
    "Sfe": "Data Source=data/sfe.db"
  },

  "Sfe": {
    "Root": "~",
    "SettingsFile": "data/settings.json",
    "OpenBrowser": true,

    "Appearance": {
      "Theme": "System"
    },

    "Database": {
      "Provider": "Sqlite",
      "MigrateOnStartup": true
    },

    "Thumbnails": {
      "CacheDirectory": "data/thumbs",
      "FfmpegPath": "ffmpeg"
    },

    "KeepAlive": {
      "Mode": "Off",
      "IntervalSeconds": 240
    }
  }
}
