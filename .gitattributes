# Shell scripts run on Linux (AppImage build): a CRLF checkout would break them.
*.sh text eol=lf
build/linux/AppRun text eol=lf
build/linux/*.desktop text eol=lf

# Windows batch files (portable package): cmd.exe expects CRLF.
*.cmd text eol=crlf

# Sample files of the tests and the docs screenshots: kept byte for byte (some text samples are CRLF on purpose).
tests/samples/library/** -text
tests/samples/media/** -text
tests/samples/archives/** -text
tests/samples/third-party/** -text
