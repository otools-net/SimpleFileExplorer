<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# client library of the SFE API (agents/docs/development/client-library-plan.md): a raw layer generated by
    Kiota from the committed v1 document into Generated/ (agents/tools/client-generation), and a hand-written facade.
    No reference to Sfe.Core or Sfe.Api: what a third-party app adds is this package and Kiota's three.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <RootNamespace>Otools.Net.Sfe.Client</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Sfe.Client</PackageId>
    <Title>SFE client library</Title>
    <Authors>otools-net</Authors>
    <Description>Client of the HTTP API (v1) of SFE, Simple File Explorer.</Description>
    <PackageTags>sfe;file-explorer;api-client</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's page (nuget.org, Visual Studio): what the package is, an example, where the guide is. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
    <!-- AddSfeClient: the HttpClient of IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <!-- IAsyncEnumerable and its iterators: in the box from .NET Core 3.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests set the size of upload chunks (SfeClientOptions.UploadChunkBytes), which is not public. -->
    <InternalsVisibleTo Include="Sfe.Client.Tests" />
  </ItemGroup>
</Project>
