{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://*:5080",

  "ConnectionStrings": {
    "Sfe": "Data Source=data/sfe.db"
  },

  "Sfe": {
    "Root": "~",
    "DataServer": "",
    "ShowHiddenItems": false,

    "Database": {
      "Provider": "Sqlite",
      "MigrateOnStartup": true
    },

    "Browse": {
      "DefaultPageSize": 120,
      "MaxPageSize": 1000,
      "FolderPictures": 4
    },

    "Search": {
      "DefaultPageSize": 120,
      "MaxPageSize": 1000,
      "Explain": true,
      "HistorySize": 10
    },

    "Scan": {
      "IgnoredDirectories": [],
      "IgnoredFiles": [ "Thumbs.db", "desktop.ini" ],
      "Parallelism": 4,
      "ComputeHashes": true
    },

    "KeepAlive": {
      "Mode": "Off",
      "IntervalSeconds": 240,
      "TimeoutSeconds": 30
    },

    "FileTypes": {
      "Images": [ "bmp", "gif", "jpeg", "jpg", "png", "tff", "tif", "tiff", "webp", "avif", "xgif" ],
      "Videos": [ "3gp", "acs", "avi", "flv", "m4v", "mkv", "mov", "mp4", "mpeg", "mpg", "rtm", "ts", "webm", "wmv" ],
      "Audio": [ "aac", "flac", "m4a", "mp3", "ogg", "opus", "wav" ]
    },

    "Thumbnails": {
      "Enabled": true,
      "CacheDirectory": "data/thumbs",
      "FfmpegPath": "ffmpeg",
      "VideoSeekSeconds": 4,
      "Width": 480,
      "LargeImageKilobytes": 512,
      "MaxConcurrency": 2,
      "TimeoutSeconds": 30
    },

    "Trickplay": {
      "Enabled": false,
      "Folders": [],
      "IntervalSeconds": 10,
      "Width": 320,
      "Columns": 10,
      "Rows": 10,
      "KeyFramesOnly": true,
      "Parallelism": 1,
      "TimeoutMinutes": 30,
      "RecheckHours": 6,
      "HoverPreview": true
    },

    "Player": {
      "SeekSeconds": 10,
      "Loop": false
    },

    "Appearance": {
      "Theme": "System"
    },

    "FileTracking": {
      "Duplicates": {
        "MinimumKilobytes": 1,
        "GroupsPerPage": 50,
        "AllowRemove": true
      },
      "Relink": {
        "Enabled": true,
        "MatchByName": true,
        "RetentionDays": 30
      }
    }
  }
}
