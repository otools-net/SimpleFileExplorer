<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A console program using the C# client library: lists a folder, uploads a file, downloads it, moves it
    (docs/reference/client-library.md). It references the project so that it builds with the repository; a program
    of yours adds the package instead: <PackageReference Include="Sfe.Client" Version="..." />.
    Run by tests/Sfe.Client.Tests (SampleTests) against the in-process server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Otools.Net.Sfe.Client.Sample</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sfe.Client\Sfe.Client.csproj" />
  </ItemGroup>
</Project>
